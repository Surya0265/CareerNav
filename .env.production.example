
# ============================================
# CareerNav Production Environment Variables
# Copy this to .env on your EC2 server
# NEVER commit this file to Git
# ============================================

# ── Docker Hub ──────────────────────────────
DOCKER_HUB_USERNAME=your_dockerhub_username

# ── Database (Use MongoDB Atlas FREE tier) ──
# Get this from cloud.mongodb.com after creating a free cluster
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/careernav?retryWrites=true&w=majority

# ── Server ──────────────────────────────────
PORT=3011
NODE_ENV=production

# ── Authentication ───────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_STRONG_64_CHAR_RANDOM_STRING

# ── Email (Gmail SMTP) ───────────────────────
EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail@gmail.com
# Use Gmail App Password (not your regular password)
# Go to: Google Account > Security > 2-Step Verification > App passwords
EMAIL_PASSWORD=your_16_char_gmail_app_password

# ── Frontend URLs (Replace with your EC2 public IP) ──
# Format: http://YOUR_EC2_PUBLIC_IP:PORT
FRONTEND_URL=http://YOUR_EC2_PUBLIC_IP:5174
ADMIN_FRONTEND_URL=http://YOUR_EC2_PUBLIC_IP:5173

# ── External APIs ────────────────────────────
# Get from Google AI Studio: aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
# Get from RapidAPI
RAPIDAPI_KEY=your_rapidapi_key_here

# ── Python / Flask ───────────────────────────
FLASK_ENV=production
FLASK_DEBUG=False
